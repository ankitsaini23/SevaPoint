<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>States & UTs | SevaPoint</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<header class="navbar"><a href="/" class="logo"><span class="logo-mark">S</span><span>Seva<span>Point</span></span></a>
<nav><a href="/">Home</a><a href="/#services">Services</a><a href="/states" class="active">States</a><a href="/#about">About</a></nav><button class="language-btn" id="languageBtn" type="button">हिंदी</button></header>
<main class="states-page">
<div class="states-header"><p class="eyebrow">INDIA</p><h1>States & Union Territories</h1><p>Explore official public services available in your state or UT.</p></div>
<div class="states-grid">
<% states.forEach(state => { %>
<a href="/states/<%= state.id %>" class="state-card">
<div class="state-code"><%= state.code %></div><div><h2><%= state.name %></h2><p><%= state.type %> · <%= state.services.length %> services available</p></div><span class="state-arrow">→</span>
</a>
<% }) %>
</div></main>
<footer><div><strong>SevaPoint</strong><p>Find. Verify. Access.</p></div><p>© 2026 SevaPoint. Independent public-service guide.</p></footer>
<script src="/js/language.js"></script>
</body></html>
