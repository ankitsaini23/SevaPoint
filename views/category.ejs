<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= category %> Services | SevaPoint</title><link rel="stylesheet" href="/css/style.css"></head>
<body><header class="navbar"><a href="/" class="logo"><span class="logo-mark">S</span><span>Seva<span>Point</span></span></a><nav><a href="/">Home</a><a href="/states">States</a></nav><button class="language-btn" id="languageBtn" type="button">हिंदी</button></header>
<main class="category-page"><div class="category-header"><p class="eyebrow">SEVAPOINT SERVICES</p><h1><%= category %></h1><p>Explore public services available in this category.</p></div>
<div class="category-services"><% if(!services.length){ %><div class="no-results"><h2>No services available</h2><p>We haven't added services to this category yet.</p></div><% } %>
<% services.forEach(service=>{ %><article class="category-service-card"><div class="category-service-icon">🏛️</div><div class="category-service-content"><div class="result-top"><span class="result-category"><%= service.category %></span><span class="result-level"><%= service.level %></span></div><h2><%= service.name %></h2><p><%= service.description %></p><span class="verified">✓ Official source</span><div class="category-actions"><a href="/services/<%= service.id %>" class="details-btn">View Details →</a><a href="<%= service.officialUrl %>" target="_blank" rel="noopener noreferrer" class="official-btn">Official Website ↗</a></div></div></article><% }) %></div></main>
<footer><div><strong>SevaPoint</strong><p>Find. Verify. Access.</p></div><p>© 2026 SevaPoint. Independent public-service guide.</p></footer><script src="/js/language.js"></script>
</body></html>